---
const {eyebrow,title,description}=Astro.props;
---
<div class="mb-8"><p class="font-sans text-xs font-semibold uppercase tracking-[.14em] text-brown">{eyebrow}</p><h2 class="mt-2 font-heading text-3xl font-semibold text-navy md:text-4xl">{title}</h2>{description&&<p class="mt-3 max-w-2xl text-muted">{description}</p>}</div>