<section class="grid gap-6 border border-border p-cardPad lg:grid-cols-2"><form id="queue-form" class="space-y-4"><div><label for="system" class="block font-sans text-xs uppercase tracking-wider">System type</label><select id="system" class="mt-1 w-full border border-border bg-cream p-3"><option value="mm1">M/M/1</option><option value="mmc">M/M/c</option></select></div><div><label for="lambda" class="block font-sans text-xs uppercase tracking-wider">Arrival rate (λ)</label><input id="lambda" type="number" min="0" step="any" value="10" required class="mt-1 w-full border border-border bg-cream p-3"/></div><div><label for="mu" class="block font-sans text-xs uppercase tracking-wider">Service rate per server (μ)</label><input id="mu" type="number" min="0" step="any" value="15" required class="mt-1 w-full border border-border bg-cream p-3"/></div><div id="servers-wrap" hidden><label for="servers" class="block font-sans text-xs uppercase tracking-wider">Servers (c)</label><input id="servers" type="number" min="1" step="1" value="3" class="mt-1 w-full border border-border bg-cream p-3"/></div><button class="h-12 bg-navy px-8 font-sans text-xs font-semibold uppercase tracking-wider text-cream">Calculate</button></form><div aria-live="polite"><h2 class="font-heading text-3xl text-navy">Results</h2><dl id="results" class="mt-5 grid grid-cols-2 gap-4"></dl><p id="warning" class="mt-5 text-sm text-brown"></p></div></section><script is:inline>const f=document.querySelector('#queue-form'),sys=document.querySelector('#system'),sw=document.querySelector('#servers-wrap'),out=document.querySelector('#results'),warn=document.querySelector('#warning');sys?.addEventListener('change',()=>sw.hidden=sys.value!=='mmc');const fact=n=>{let x=1;for(let i=2;i<=n;i++)x*=i;return x};f?.addEventListener('submit',e=>{e.preventDefault();const l=Number(document.querySelector('#lambda').value),m=Number(document.querySelector('#mu').value),c=sys.value==='mmc'?Number(document.querySelector('#servers').value):1,r=l/(c*m);if(!l||!m||!c||r>=1){out.innerHTML='';warn.textContent=r>=1?'The system is unstable: arrival demand meets or exceeds total service capacity.':'Enter positive values.';return}let Lq;if(c===1)Lq=r*r/(1-r);else{let sum=0;const a=l/m;for(let n=0;n<c;n++)sum+=a**n/fact(n);const p0=1/(sum+a**c/(fact(c)*(1-r)));const pw=a**c/(fact(c)*(1-r))*p0;Lq=pw*r/(1-r)}const Wq=Lq/l,W=Wq+1/m,L=l*W;const vals=[['Utilization ρ',r],['L (system)',L],['Lq (queue)',Lq],['W (system)',W],['Wq (queue)',Wq]];out.innerHTML=vals.map(([k,v])=>`<div class="border-b border-border pb-2"><dt class="font-sans text-xs text-muted">${k}</dt><dd class="font-heading text-2xl text-navy">${v.toFixed(4)}</dd></div>`).join('');warn.textContent='Planning estimate under Markovian steady-state assumptions; not an operational guarantee.'});f?.dispatchEvent(new Event('submit',{cancelable:true,bubbles:true}));</script>