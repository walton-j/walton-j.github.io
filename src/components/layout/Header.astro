---
const links=[['/','Home'],['/research','Research'],['/publications','Publications'],['/projects','Projects'],['/writing','Writing'],['/teaching','Teaching'],['/cv','CV'],['/contact','Contact']];
const path=Astro.url.pathname.replace(/\/$/,'')||'/'; const active=(href: string)=>href==='/'?path==='/':path===href||path.startsWith(href+'/');
---
<header class="border-b border-border/70"><div class="mx-auto flex max-w-site items-center justify-between px-pageX py-4 lg:py-5"><a href="/" aria-label="Joseph A. Walton home" class="flex items-center gap-3 no-underline"><img src="/crest-mark.jpg" width="64" height="64" alt="Joseph A. Walton crest" class="h-14 w-14 rounded-full object-cover lg:h-16 lg:w-16"/><span class="hidden font-sans text-[10px] font-semibold uppercase tracking-[.18em] text-navy sm:block">Joseph A. Walton</span></a><nav aria-label="Primary navigation" class="hidden items-center gap-7 lg:flex">{links.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined} class:list={["border-b-2 border-transparent py-2 font-sans text-[11px] font-medium tracking-wide no-underline",active(href)&&"border-brown text-brown"]}>{label}</a>)}</nav><button id="menu-button" class="border border-border px-3 py-2 font-sans text-xs uppercase tracking-widest text-navy lg:hidden" aria-expanded="false" aria-controls="mobile-nav">Menu</button></div><nav id="mobile-nav" aria-label="Mobile navigation" class="hidden border-t border-border bg-paper px-pageX py-3 lg:hidden">{links.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined} class:list={["block border-b border-border/70 py-3 font-sans text-xs uppercase tracking-wider no-underline",active(href)&&"text-brown"]}>{label}</a>)}</nav></header><script is:inline>const b=document.getElementById('menu-button'),n=document.getElementById('mobile-nav');b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));n?.classList.toggle('hidden',open)});</script>