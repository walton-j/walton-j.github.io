---
const {title,description,icon='◇',status,href}=Astro.props;
---
<article class="flex h-full flex-col border border-border p-cardPad"><div class="flex items-start justify-between gap-3"><span class="font-heading text-4xl text-gold" aria-hidden="true">{icon}</span>{status&&<span class="font-sans text-[10px] uppercase tracking-wider text-muted">{status}</span>}</div><h2 class="mt-4 font-heading text-2xl font-semibold text-navy">{title}</h2><p class="mt-2 flex-1 text-sm text-muted">{description}</p><a href={href} class="mt-6 font-sans text-[11px] font-semibold uppercase tracking-wider">View project →</a></article>