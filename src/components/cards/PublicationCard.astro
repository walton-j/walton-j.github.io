---
const {publication:p}=Astro.props;
---
<article class="publication-card border border-border p-cardPad" data-type={p.type}><div class="flex justify-between gap-4"><span class="font-sans text-[10px] font-semibold uppercase tracking-[.14em] text-brown">{p.type}</span><span class="font-sans text-xs text-muted">{p.year}</span></div><h2 class="mt-3 font-heading text-2xl font-semibold leading-tight text-navy">{p.title}</h2><p class="mt-2 text-sm text-muted">{p.authors.join(', ')}</p><p class="mt-1 text-sm italic">{p.venue} · {p.status}</p><details class="mt-4"><summary class="cursor-pointer font-sans text-[11px] font-semibold uppercase tracking-wider text-navy">Abstract</summary><p class="mt-2 text-sm text-muted">{p.abstract}</p></details><div class="mt-5 flex flex-wrap gap-4 font-sans text-[11px] font-semibold uppercase tracking-wider">{p.links?.pdf&&<a href={p.links.pdf}>PDF</a>}{p.links?.bibtex&&<a href={p.links.bibtex}>BibTeX</a>}{p.links?.code&&<a href={p.links.code}>Code</a>}</div></article>