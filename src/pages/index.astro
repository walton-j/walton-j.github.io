---
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/feature/Hero.astro'; import ResearchFocusCard from '../components/cards/ResearchFocusCard.astro'; import SectionHeader from '../components/ui/SectionHeader.astro'; import {getCollection} from 'astro:content';
const writing=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<BaseLayout title="Joseph A. Walton" description="Academic portfolio of Joseph A. Walton: Operations Research, reinforcement learning, queueing, simulation, and decision systems."><Hero/><div class="ornament mx-auto flex max-w-site items-center gap-5 px-pageX py-4"><span class="text-2xl text-gold" aria-hidden="true">❧</span></div><section class="mx-auto max-w-site px-pageX py-sectionY"><SectionHeader eyebrow="Overview" title="Research, applied work, and current thinking"/><div class="grid gap-gridGap lg:grid-cols-3"><ResearchFocusCard icon="⌁" title="Research Focus" body="Sequential decision making, reinforcement learning, simulation, and stochastic optimization." href="/research"/><ResearchFocusCard icon="§" title="Selected Work" body="Policy-gradient reinforcement learning for dynamic service control in an M/M/1 queue." href="/publications"/><ResearchFocusCard icon="⚙" title="Recent Project" body="A scalable machine-interference repair-control testbed with speed-dependent failures." href="/projects/machine-repair-simulator"/></div></section><section class="bg-paper"><div class="mx-auto max-w-site px-pageX py-8"><div class="grid gap-5 md:grid-cols-[180px_1fr]"><h2 class="font-sans text-xs font-semibold uppercase tracking-[.14em] text-navy">Recent Writing</h2><div class="grid gap-4 md:grid-cols-3">{writing.map(x=><a href={`/writing/${x.id}/`} class="text-sm no-underline"><span class="block font-heading text-lg font-semibold text-navy">{x.data.title}</span><span class="font-sans text-[10px] uppercase text-muted">{x.data.date.toLocaleDateString()}</span></a>)}</div></div></div></section></BaseLayout>