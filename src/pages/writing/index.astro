---
import BaseLayout from '../../layouts/BaseLayout.astro'; import WritingCard from '../../components/cards/WritingCard.astro'; import {getCollection} from 'astro:content'; const entries=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const cats=['All',...new Set(entries.map(e=>e.data.category))];
---
<BaseLayout title="Writing" description="Research notes, operations research insights, reading notes, and reflections on the PhD journey."><section class="mx-auto max-w-site px-pageX py-sectionY"><h1 class="font-heading text-5xl font-medium text-navy">Writing</h1><p class="mt-4">Thoughts on research, methods, operations research, and the PhD journey.</p><div class="mt-8 flex flex-wrap gap-5 border-b border-border">{cats.map((c,i)=><button class="filter-button border-b-2 border-transparent pb-3 font-sans text-xs" data-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><div class="mt-4">{entries.map(e=><WritingCard entry={e}/>)}</div></section><script is:inline>const bs=[...document.querySelectorAll('.filter-button')],cards=[...document.querySelectorAll('.writing-card')];bs.forEach(b=>b.addEventListener('click',()=>{bs.forEach(x=>x.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true');cards.forEach(c=>c.hidden=b.dataset.filter!=='All'&&c.dataset.category!==b.dataset.filter)}));</script></BaseLayout>