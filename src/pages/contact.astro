---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact Joseph A. Walton for research collaboration, teaching, operations research, simulation, or decision analytics."><section class="mx-auto max-w-site px-pageX py-sectionY"><h1 class="font-heading text-5xl font-medium text-navy">Contact</h1><p class="mt-4">I would be glad to hear from you.</p><div class="mt-10 grid gap-12 lg:grid-cols-2"><div class="space-y-5"><p><strong class="font-sans text-xs uppercase tracking-wider text-navy">Email</strong><br/><a href="mailto:waltonj.pe@gmail.com">waltonj.pe@gmail.com</a></p><p><strong class="font-sans text-xs uppercase tracking-wider text-navy">LinkedIn</strong><br/><a href="https://www.linkedin.com/in/joseph-a-walton/">Professional profile</a></p><p><strong class="font-sans text-xs uppercase tracking-wider text-navy">GitHub</strong><br/><a href="https://github.com/walton-j">github.com/walton-j</a></p><p><strong class="font-sans text-xs uppercase tracking-wider text-navy">Location</strong><br/>Rolla, Missouri, USA</p></div><form action="mailto:waltonj.pe@gmail.com" method="post" enctype="text/plain" class="space-y-4"><div><label for="name" class="block font-sans text-xs uppercase tracking-wider">Name</label><input id="name" name="name" required class="mt-1 w-full border border-border bg-cream p-3"/></div><div><label for="email" class="block font-sans text-xs uppercase tracking-wider">Email</label><input id="email" name="email" type="email" required class="mt-1 w-full border border-border bg-cream p-3"/></div><div><label for="subject" class="block font-sans text-xs uppercase tracking-wider">Subject</label><input id="subject" name="subject" class="mt-1 w-full border border-border bg-cream p-3"/></div><div><label for="message" class="block font-sans text-xs uppercase tracking-wider">Message</label><textarea id="message" name="message" rows="6" required class="mt-1 w-full border border-border bg-cream p-3"></textarea></div><button class="h-12 bg-brown px-8 font-sans text-xs font-semibold uppercase tracking-wider text-cream">Send message</button></form></div></section></BaseLayout>