---
import BaseLayout from '../layouts/BaseLayout.astro'; import ResearchFocusCard from '../components/cards/ResearchFocusCard.astro'; import {getCollection} from 'astro:content'; const projects=(await getCollection('projects')).filter(p=>p.data.featured);
---
<BaseLayout title="Research" description="Research in sequential decision making, reinforcement learning, simulation, queueing, and stochastic optimization."><section class="mx-auto max-w-site px-pageX py-sectionY"><h1 class="font-heading text-5xl font-medium text-navy">Research</h1><p class="mt-4 max-w-2xl">My research sits at the intersection of operations research, reinforcement learning, and stochastic systems. I focus on designing algorithms with theoretical structure and evaluating them in realistic simulation environments.</p><div class="mt-10 max-w-4xl space-y-5"><ResearchFocusCard icon="⌁" title="Sequential Decision Making" body="Modeling and solving sequential problems under uncertainty using dynamic programming, approximate dynamic programming, MDPs, and SMDPs."/><ResearchFocusCard icon="∿" title="Reinforcement Learning" body="Theory and algorithms for learning control policies in stochastic operational systems, with attention to stability, constraints, and interpretability."/><ResearchFocusCard icon="◇" title="Simulation & Evaluation" body="Building high-fidelity environments to validate policies, understand behavior, and guide decision-making before deployment."/><ResearchFocusCard icon="⊹" title="Stochastic Optimization" body="Developing tractable decision models under uncertainty for operations, reliability, service systems, and logistics."/></div><div class="mt-12 border border-border bg-paper p-cardPad"><div class="flex flex-wrap items-end justify-between gap-4"><div><h2 class="font-heading text-3xl text-navy">Current research projects</h2><ul class="mt-4 list-disc space-y-2 pl-5">{projects.map(p=><li><a href={`/projects/${p.id}/`}>{p.data.title}</a></li>)}</ul></div><a href="/projects" class="font-sans text-xs uppercase tracking-wider">View all projects →</a></div></div></section></BaseLayout>