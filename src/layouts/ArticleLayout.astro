---
import BaseLayout from './BaseLayout.astro'; const {frontmatter}=Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}><article class="mx-auto max-w-prose px-pageX py-sectionY"><p class="font-sans text-xs uppercase tracking-[.12em] text-muted">{frontmatter.category} · {frontmatter.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</p><h1 class="mt-3 font-heading text-4xl font-medium leading-tight text-navy md:text-5xl">{frontmatter.title}</h1><p class="mt-4 text-lg italic text-muted">{frontmatter.description}</p><div class="prose mt-10"><slot/></div></article></BaseLayout>