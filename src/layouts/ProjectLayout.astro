---
import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '../components/ui/Breadcrumbs.astro'; const {frontmatter}=Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}><article class="mx-auto max-w-site px-pageX py-sectionY"><Breadcrumbs items={[{label:'Projects',href:'/projects'},{label:frontmatter.title}]}/><p class="mt-8 font-sans text-xs uppercase tracking-[.12em] text-brown">{frontmatter.status}</p><h1 class="mt-2 font-heading text-5xl font-medium text-navy">{frontmatter.title}</h1><p class="mt-3 max-w-3xl text-xl italic text-muted">{frontmatter.subtitle}</p><div class="prose mt-10"><slot/></div></article></BaseLayout>